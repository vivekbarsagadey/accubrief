{
    // =============================================
    // Spell Check Configuration
    // =============================================
    "cSpell.enabled": true,
    "cSpell.language": "en",
    "cSpell.enableFiletypes": [
        "python",
        "typescript",
        "typescriptreact",
        "javascript",
        "javascriptreact",
        "markdown",
        "json",
        "yaml"
    ],
    "cSpell.ignorePaths": [
        "node_modules/**",
        ".git/**",
        "**/__pycache__/**",
        "**/.venv/**",
        "**/venv/**",
        "**/dist/**",
        "**/build/**",
        "**/*.min.js",
        "**/package-lock.json",
        "**/*.lock"
    ],
    "cSpell.words": [
        "Accu",
        "accubrief",
        "addopts",
        "alembic",
        "chatagent",
        "coturn",
        "dataavailable",
        "dataclass",
        "Deepgram",
        "diarization",
        "fastapi",
        "hashlib",
        "hexdigest",
        "hmac",
        "isoformat",
        "langchain",
        "langgraph",
        "LRANGE",
        "markitdown",
        "Mediasoup",
        "mgmt",
        "microsoftdocs",
        "minioadmin",
        "Ollama",
        "oniceconnectionstatechange",
        "PKCS",
        "psql",
        "Pyannote",
        "pydantic",
        "pytest",
        "retryability",
        "rollouts",
        "sess",
        "sqlalchemy",
        "tablename",
        "timedelta",
        "transcription",
        "unmute",
        "utcnow",
        "webrtc",
        "webhook"
    ],
    
    // =============================================
    // Task Runner Configuration
    // =============================================
    "tasks.autoDetect": "on"
}